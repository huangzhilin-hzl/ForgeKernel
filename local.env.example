# Copy to local.env (gitignored): the machine a run uses. Never part of a task.
# The environment wins over this file for any key both set.

# Where the GPU is: this machine (local), an SSH host (ssh), or a Pod (kubectl).
FK_DELIVERY=local
# The CUDA device to run on; forgekernel's runs on one GPU take turns (a per-GPU lock).
FK_GPU=0

# ssh only: a host alias that logs in without a prompt.
REMOTE_HOST=
# ssh/kubectl: a directory dedicated to ForgeKernel and an optional environment script.
REMOTE_WORKDIR=
REMOTE_ENV_FILE=

# kubectl only: namespace, Pod and container. Leave kubeconfig empty for kubectl's default.
KUBECTL_KUBECONFIG=
KUBECTL_NAMESPACE=
KUBECTL_POD=
KUBECTL_CONTAINER=

# Credentials for the agents (Claude Code) with provider = "native": one of these, or the
# CLI's own login. A provider of global_config/backends.toml reads its key from the variable
# its key_env names; set that variable here.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
